<?xml version="1.0" encoding="UTF-8"?>
<usereventscript scriptid="customscript_sust_ue_line_links">
  <name>SUST - Line Settlement Links</name>
  <scriptfile>[/SuiteScripts/Sustana/SUST_UE_LineSettlementLinks.js]</scriptfile>
  <description>v2.3: beforeLoad on PO/IR. Populates per-line settlement/processing link columns and adds the Create/Manage Line Settlements button (Sustana Recovery subsidiary).</description>
  <isinactive>F</isinactive>
  <notifyadmins>F</notifyadmins>
  <notifyemails></notifyemails>
  <notifyowner>T</notifyowner>
  <notifyuser>F</notifyuser>
  <scriptcustomfields>
    <scriptcustomfield scriptid="custscript_sust_line_links_sub_id">
      <accesslevel>2</accesslevel>
      <applyformatting>F</applyformatting>
      <defaultchecked>F</defaultchecked>
      <defaultselection></defaultselection>
      <defaultvalue></defaultvalue>
      <description>Internal ID of the Sustana Recovery subsidiary. Line-link columns and the Create/Manage button only render on transactions in this subsidiary.</description>
      <displaytype>NORMAL</displaytype>
      <fieldtype>INTEGER</fieldtype>
      <help>Required. Set to the Sustana Recovery subsidiary's internal ID.</help>
      <isformula>F</isformula>
      <ismandatory>F</ismandatory>
      <label>Sustana Recovery Subsidiary ID</label>
      <searchlevel>2</searchlevel>
      <storevalue>T</storevalue>
    </scriptcustomfield>
  </scriptcustomfields>
  <scriptdeployments>
    <scriptdeployment scriptid="customdeploy_sust_ue_line_links_po">
      <allemployees>F</allemployees>
      <allpartners>F</allpartners>
      <allroles>T</allroles>
      <auddepartment></auddepartment>
      <audslctrole></audslctrole>
      <isdeployed>T</isdeployed>
      <loglevel>DEBUG</loglevel>
      <recordtype>PURCHASEORDER</recordtype>
      <runasrole></runasrole>
      <status>RELEASED</status>
    </scriptdeployment>
    <scriptdeployment scriptid="customdeploy_sust_ue_line_links_ir">
      <allemployees>F</allemployees>
      <allpartners>F</allpartners>
      <allroles>T</allroles>
      <auddepartment></auddepartment>
      <audslctrole></audslctrole>
      <isdeployed>T</isdeployed>
      <loglevel>DEBUG</loglevel>
      <recordtype>ITEMRECEIPT</recordtype>
      <runasrole></runasrole>
      <status>RELEASED</status>
    </scriptdeployment>
  </scriptdeployments>
</usereventscript>
