<?xml version="1.0" encoding="UTF-8"?>
<suitelet scriptid="customscript_sust_sl_position_report">
  <name>SUST - Fiber Position Report</name>
  <scriptfile>[/SuiteScripts/Sustana/SUST_SL_PositionReport.js]</scriptfile>
  <description>Fiber position report — tonnage by grade across open purchase commitments (expected inbound) + on-hand inventory.</description>
  <isinactive>F</isinactive>
  <notifyadmins>F</notifyadmins>
  <notifyemails></notifyemails>
  <notifyowner>T</notifyowner>
  <notifyuser>F</notifyuser>
  <scriptcustomfields>
    <scriptcustomfield scriptid="custscript_sust_posrpt_sub_id">
      <accesslevel>2</accesslevel>
      <applyformatting>F</applyformatting>
      <defaultchecked>F</defaultchecked>
      <defaultselection></defaultselection>
      <defaultvalue></defaultvalue>
      <description>Optional. Internal ID of the Sustana Recovery subsidiary. If set, the report only counts transactions in this subsidiary; if blank, all subsidiaries are included. URL override: ?sub=&lt;id&gt;.</description>
      <displaytype>NORMAL</displaytype>
      <fieldtype>INTEGER</fieldtype>
      <help>Optional. Set to the Sustana Recovery subsidiary's internal ID to scope the report.</help>
      <isformula>F</isformula>
      <ismandatory>F</ismandatory>
      <label>Sustana Recovery Subsidiary ID</label>
      <searchlevel>2</searchlevel>
      <storevalue>T</storevalue>
    </scriptcustomfield>
  </scriptcustomfields>
  <scriptdeployments>
    <scriptdeployment scriptid="customdeploy_sust_sl_position_report">
      <allemployees>F</allemployees>
      <allpartners>F</allpartners>
      <allroles>T</allroles>
      <auddepartment></auddepartment>
      <audslctrole></audslctrole>
      <isdeployed>T</isdeployed>
      <loglevel>DEBUG</loglevel>
      <runasrole></runasrole>
      <status>RELEASED</status>
      <title>SUST - Fiber Position Report</title>
    </scriptdeployment>
  </scriptdeployments>
</suitelet>
