<?xml version="1.0" encoding="UTF-8"?>
<usereventscript scriptid="customscript_sust_ue_po_valid">
  <name>SUST - PO Validation</name>
  <scriptfile>[/SuiteScripts/Sustana/SUST_UE_POValidation.js]</scriptfile>
  <description>v2: Pricing-timing-mode aware PO handler. Renders mode guidance banner; defaults pricing_timing; validates lines against mode rules. CROSS-020.</description>
  <isinactive>F</isinactive>
  <notifyadmins>F</notifyadmins>
  <notifyemails></notifyemails>
  <notifyowner>T</notifyowner>
  <notifyuser>F</notifyuser>
  <scriptcustomfields>
    <scriptcustomfield scriptid="custscript_sust_sub_id_po">
      <accesslevel>2</accesslevel>
      <applyformatting>F</applyformatting>
      <defaultchecked>F</defaultchecked>
      <defaultselection></defaultselection>
      <defaultvalue></defaultvalue>
      <description>Internal ID of the Sustana Recovery subsidiary. PO validation only fires for POs in this subsidiary.</description>
      <displaytype>NORMAL</displaytype>
      <fieldtype>INTEGER</fieldtype>
      <help>Required. Set to the Sustana Recovery subsidiary's internal ID.</help>
      <isformula>F</isformula>
      <ismandatory>F</ismandatory>
      <label>Sustana Recovery Subsidiary ID</label>
      <searchlevel>2</searchlevel>
      <storevalue>T</storevalue>
    </scriptcustomfield>
  </scriptcustomfields>
  <scriptdeployments>
    <scriptdeployment scriptid="customdeploy_sust_ue_po_valid">
      <allemployees>F</allemployees>
      <allpartners>F</allpartners>
      <allroles>T</allroles>
      <auddepartment></auddepartment>
      <audslctrole></audslctrole>
      <isdeployed>T</isdeployed>
      <loglevel>DEBUG</loglevel>
      <recordtype>PURCHASEORDER</recordtype>
      <runasrole></runasrole>
      <status>RELEASED</status>
    </scriptdeployment>
  </scriptdeployments>
</usereventscript>
