<suitelet scriptid="customscript_sust_sl_settle_action">
  <name>SUST - Settlement Action</name>
  <scriptfile>[/SuiteScripts/Sustana/SUST_SL_SettlementAction.js]</scriptfile>
  <description>One-click settlement lifecycle actions (Approve/Complete, Provisional Paid, Price Fixed, Final Settle) launched from buttons on the settlement record. Performs a normal record save so all guards (SETTLE-012) and bill-creating status-change UEs still fire.</description>
  <isinactive>F</isinactive>
  <notifyadmins>F</notifyadmins>
  <notifyemails></notifyemails>
  <notifyowner>T</notifyowner>
  <notifyuser>F</notifyuser>
  <scriptdeployments>
    <scriptdeployment scriptid="customdeploy_sust_sl_settle_action">
      <allemployees>F</allemployees>
      <allpartners>F</allpartners>
      <allroles>T</allroles>
      <auddepartment></auddepartment>
      <audslctrole></audslctrole>
      <isdeployed>T</isdeployed>
      <loglevel>DEBUG</loglevel>
      <runasrole></runasrole>
      <status>RELEASED</status>
      <title>Settlement Action</title>
    </scriptdeployment>
  </scriptdeployments>
</suitelet>
